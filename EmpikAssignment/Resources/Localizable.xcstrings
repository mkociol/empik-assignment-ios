{
  "sourceLanguage": "en",
  "strings": {
    "Hello, world!": {},
    "cityNameValidation.consecutiveSpacesOrHyphens": {
      "comment": "Shown when the typed city name has two spaces or hyphens next to each other.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only one space or hyphen between words."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Między słowami może być tylko jedna spacja lub myślnik."
          }
        }
      }
    },
    "cityNameValidation.containsDigits": {
      "comment": "Shown under the search field when the typed city name contains digits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A city name can't contain digits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa miasta nie może zawierać cyfr."
          }
        }
      }
    },
    "cityNameValidation.containsSpecialCharacters": {
      "comment": "Shown when the typed city name contains characters other than letters, spaces and hyphens.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only letters, spaces and hyphens are allowed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozwolone są tylko litery, spacje i myślniki."
          }
        }
      }
    },
    "cityNameValidation.startsWithSpaceOrHyphen": {
      "comment": "Shown when the typed city name starts with a space or a hyphen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A city name can't start with a space or hyphen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa miasta nie może zaczynać się od spacji ani myślnika."
          }
        }
      }
    },
    "emptySearchResult.description": {
      "comment": "Description of the empty search state. %@ is the city name the user typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cities found for “%@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono miast dla „%@”."
          }
        }
      }
    },
    "emptySearchResult.title": {
      "comment": "Title of the state shown when the city search found nothing.",
      "extractionState": "manual",
      "localizations": {
