          "stringUnit": {
            "state": "translated",
            "value": "No Results"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wyników"
          }
        }
      }
    },
    "errorState.description": {
      "comment": "Description shown when loading data failed and the server gave no reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't load the data. Please try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać danych. Spróbuj ponownie."
          }
        }
      }
    },
