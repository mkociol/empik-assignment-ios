{
  "sourceLanguage": "en",
  "strings": {
    "cityNameValidation.consecutiveSpacesOrHyphens": {
      "comment": "Shown when the typed city name has two spaces or hyphens next to each other.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only one space or hyphen between words."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Między słowami może być tylko jedna spacja lub myślnik."
          }
        }
      }
    },
    "cityNameValidation.containsDigits": {
      "comment": "Shown under the search field when the typed city name contains digits.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A city name can't contain digits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa miasta nie może zawierać cyfr."
          }
        }
      }
    },
    "cityNameValidation.containsSpecialCharacters": {
      "comment": "Shown when the typed city name contains characters other than letters, spaces and hyphens.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only letters, spaces and hyphens are allowed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozwolone są tylko litery, spacje i myślniki."
          }
        }
      }
    },
    "cityNameValidation.startsWithSpaceOrHyphen": {
      "comment": "Shown when the typed city name starts with a space or a hyphen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A city name can't start with a space or hyphen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa miasta nie może zaczynać się od spacji ani myślnika."
          }
        }
      }
    },
    "clearHistoryDialog.cancelButton": {
      "comment": "Button in the dialog that keeps the search history.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj"
          }
        }
      }
    },
    "clearHistoryDialog.confirmButton": {
      "comment": "Button in the dialog that clears the search history.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear History"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść historię"
          }
        }
      }
    },
    "clearHistoryDialog.title": {
      "comment": "Title of the dialog that confirms clearing the search history.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search history?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyścić historię wyszukiwania?"
          }
        }
      }
    },
    "currentWeather.title": {
      "comment": "Title of the card with the current temperature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz"
          }
        }
      }
    },
    "emptySearchResult.description": {
      "comment": "Description of the empty search state. %@ is the city name the user typed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cities found for “%@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono miast dla „%@”."
          }
        }
      }
    },
    "emptySearchResult.title": {
      "comment": "Title of the state shown when the city search found nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Results"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wyników"
          }
        }
      }
    },
    "errorState.description": {
      "comment": "Description shown when loading data failed and the server gave no reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't load the data. Please try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać danych. Spróbuj ponownie."
          }
        }
      }
    },
    "errorState.title": {
      "comment": "Title of the state shown when loading data failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something Went Wrong"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak"
          }
        }
      }
    },
    "hourlyForecast.now": {
      "comment": "Shown instead of the time in the first row of the hourly forecast.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz"
          }
        }
      }
    },
    "hourlyForecast.title": {
      "comment": "Title of the card with the forecast for the next 24 hours.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next 24 Hours"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbliższe 24 godziny"
          }
        }
      }
    },
    "hourlyForecastRow.accessibilityLabel": {
      "comment": "Read by VoiceOver for one hour of the forecast. %1$@ is the hour (or “Now”), %2$@ the temperature, %3$@ the chance of precipitation in percent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@ chance of precipitation"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, szansa opadów %3$@"
          }
        }
      }
    },
    "hourlyForecastRow.accessibilityLabelWithoutPrecipitation": {
      "comment": "Read by VoiceOver for one hour of the forecast when the chance of precipitation is missing. %1$@ is the hour (or “Now”), %2$@ the temperature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, no precipitation forecast"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, brak prognozy opadów"
          }
        }
      }
    },
    "invalidCityName.title": {
      "comment": "Title shown when the typed city name isn't valid; the reason is shown below it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid City Name"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowa nazwa miasta"
          }
        }
      }
    },
    "loadingState.title": {
      "comment": "Shown while data is loading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładowanie…"
          }
        }
      }
    },
    "noCitySelected.description": {
      "comment": "Description shown in the forecast area before a city is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for a city to see its weather forecast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj miasto, aby zobaczyć prognozę pogody."
          }
        }
      }
    },
    "noCitySelected.title": {
      "comment": "Title shown in the forecast area before a city is selected (iPad and wide windows).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a City"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz miasto"
          }
        }
      }
    },
    "noData.accessibilityLabel": {
      "comment": "Read by VoiceOver when a value is missing and a dash is shown instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak danych"
          }
        }
      }
    },
    "offlineState.description": {
      "comment": "Description of the state shown when the device is offline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
